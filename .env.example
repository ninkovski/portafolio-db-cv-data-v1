# Configuración de Variables de Entorno (Local Development)

# Copia este archivo como .env y completa con tus valores reales
# NUNCA commitees el archivo .env al repositorio

# ===== Airtable Configuration =====
AIRTABLE_API_KEY=patXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# ===== Azure Cosmos DB Configuration =====
COSMOS_CONNECTION_STRING=AccountEndpoint=https://YOUR_ACCOUNT.documents.azure.com:443/;AccountKey=YOUR_KEY==;
COSMOS_DATABASE_NAME=cv-database
COSMOS_CONTAINER_NAME=cv-data

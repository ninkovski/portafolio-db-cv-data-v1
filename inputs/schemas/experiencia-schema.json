{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Experiencia Profesional Schema",
  "description": "Esquema para entradas de experiencia profesional",
  "type": "object",
  "required": ["id", "tipo", "header", "bloques_logros"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^exp-[a-z0-9-]+$",
      "description": "ID único de la experiencia (ej: exp-nttdata-001)"
    },
    "tipo": {
      "type": "string",
      "enum": ["EXPERIENCIA"],
      "description": "Tipo de entidad fijo"
    },
    "header": {
      "type": "object",
      "required": ["entidad", "titulo_rol", "periodo"],
      "properties": {
        "entidad": {
          "type": "string",
          "minLength": 1,
          "description": "Nombre de la empresa/cliente (ej: NTT Data)"
        },
        "titulo_rol": {
          "type": "string",
          "minLength": 1,
          "description": "Título del puesto (ej: Senior Software Developer)"
        },
        "periodo": {
          "type": "object",
          "required": ["inicio", "actual"],
          "properties": {
            "inicio": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$",
              "description": "Fecha de inicio (YYYY-MM)"
            },
            "fin": {
              "type": ["string", "null"],
              "pattern": "^\\d{4}-\\d{2}$",
              "description": "Fecha de fin (YYYY-MM) o null si actual"
            },
            "actual": {
              "type": "boolean",
              "description": "¿Trabajo actual? true/false"
            }
          }
        }
      }
    },
    "bloques_logros": {
      "type": "array",
      "minItems": 1,
      "description": "Lista de logros/responsabilidades",
      "items": {
        "type": "object",
        "required": ["id", "descripcion", "tags_relacionados"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^l-[a-z0-9-]+$",
            "description": "ID único del logro (ej: l-ntt-01)"
          },
          "descripcion": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500,
            "description": "Descripción del logro (10-500 caracteres)"
          },
          "tags_relacionados": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^t-[a-z0-9-]+$"
            },
            "description": "Tags de tecnologías (mínimo 1)"
          }
        }
      }
    }
  }
}

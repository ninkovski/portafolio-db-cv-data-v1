{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Educación Schema",
  "description": "Esquema para entradas de educación y formación",
  "type": "object",
  "required": ["id", "tipo", "header", "detalles"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^edu-[a-z0-9-]+$",
      "description": "ID único de la educación (ej: edu-pucp-001)"
    },
    "tipo": {
      "type": "string",
      "enum": ["EDUCACION"],
      "description": "Tipo de entidad fijo"
    },
    "header": {
      "type": "object",
      "required": ["institucion", "titulo_grado", "periodo"],
      "properties": {
        "institucion": {
          "type": "string",
          "minLength": 1,
          "description": "Nombre de la institución (ej: Pontificia Universidad Católica del Perú)"
        },
        "titulo_grado": {
          "type": "string",
          "minLength": 1,
          "description": "Título obtenido (ej: Ingeniería de Software)"
        },
        "periodo": {
          "type": "object",
          "required": ["inicio", "fin"],
          "properties": {
            "inicio": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$",
              "description": "Fecha de inicio (YYYY-MM)"
            },
            "fin": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$",
              "description": "Fecha de conclusión (YYYY-MM)"
            }
          }
        }
      }
    },
    "detalles": {
      "type": "array",
      "minItems": 0,
      "description": "Logros, cursos o detalles adicionales",
      "items": {
        "type": "object",
        "required": ["id", "descripcion"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^det-[a-z0-9-]+$",
            "description": "ID único del detalle"
          },
          "descripcion": {
            "type": "string",
            "minLength": 5,
            "description": "Descripción del detalle"
          },
          "tags_relacionados": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^t-[a-z0-9-]+$"
            },
            "description": "Tags opcionalmente relacionados"
          }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Proyecto Schema",
  "description": "Esquema para entradas de proyectos personales/profesionales",
  "type": "object",
  "required": ["id", "tipo", "header", "bloques_logros"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^proj-[a-z0-9-]+$",
      "description": "ID único del proyecto (ej: proj-pandero-001)"
    },
    "tipo": {
      "type": "string",
      "enum": ["PROYECTO"],
      "description": "Tipo de entidad fijo"
    },
    "header": {
      "type": "object",
      "required": ["nombre", "descripcion_general", "periodo"],
      "properties": {
        "nombre": {
          "type": "string",
          "minLength": 1,
          "description": "Nombre del proyecto"
        },
        "descripcion_general": {
          "type": "string",
          "minLength": 10,
          "description": "Descripción general del proyecto"
        },
        "url": {
          "type": ["string", "null"],
          "description": "URL del proyecto si es público"
        },
        "periodo": {
          "type": "object",
          "required": ["inicio", "fin"],
          "properties": {
            "inicio": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$",
              "description": "Fecha de inicio (YYYY-MM)"
            },
            "fin": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$",
              "description": "Fecha de conclusión (YYYY-MM)"
            }
          }
        }
      }
    },
    "bloques_logros": {
      "type": "array",
      "minItems": 1,
      "description": "Logros o features del proyecto",
      "items": {
        "type": "object",
        "required": ["id", "descripcion", "tags_relacionados"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^l-proj-[a-z0-9-]+$",
            "description": "ID único del logro"
          },
          "descripcion": {
            "type": "string",
            "minLength": 10,
            "description": "Descripción del logro/feature"
          },
          "tags_relacionados": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^t-[a-z0-9-]+$"
            },
            "description": "Tecnologías utilizadas"
          }
        }
      }
    }
  }
}
